# ─────────────────────────────────────────────────────────────
# LinguaLayer — Bidirectional AI Translation for Laravel
# ─────────────────────────────────────────────────────────────
# Copy relevant lines to your app's .env file.
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey

# ── Required ──────────────────────────────────────────────────
LINGUA_GEMINI_KEY=

# ── Language settings ─────────────────────────────────────────
# Source = the language YOUR content is written in. Leave this unset to follow
# your app's locale (config/app.php → 'locale', usually 'en'); set it only when
# your content is written in a different language than your app locale.
# LINGUA_SOURCE_LANG=en
LINGUA_GEMINI_MODEL=gemini-2.5-flash
# Comma-separated target codes to expose in the selector (default: all built-in
# languages). Narrow to just the languages you serve, e.g. en,fr,de.
# LINGUA_TARGET_LANGUAGES=

# ── AI provider (standalone mode) ─────────────────────────────
# gemini (default) | openai
# 'openai' works with ANY OpenAI-compatible /chat/completions endpoint:
# OpenAI, Groq, Together, Mistral, or a self-hosted model (Ollama, vLLM,
# LocalAI) — just point LINGUA_OPENAI_BASE_URL at it.
LINGUA_PROVIDER=gemini
LINGUA_OPENAI_KEY=
LINGUA_OPENAI_MODEL=gpt-4o-mini
LINGUA_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Translation engine (quality) ──────────────────────────────
# domain: generic (default) | medical | legal | ecommerce | technical |
#         finance | hospitality | or any free-text domain.
LINGUA_DOMAIN=generic
# formality: formal (default) | informal | neutral
LINGUA_FORMALITY=formal
# Comma-separated terms that must NEVER be translated (brand/product names).
LINGUA_BRAND_TERMS=
# Master switch for placeholder/variable/brand masking (recommended on).
LINGUA_PRESERVE=true
# Fragments per LLM round-trip; higher = fewer calls = faster cold translation
# (tune down only if very long fragments hit the model's output-token ceiling).
LINGUA_CHUNK_SIZE=60

# ── Rate limits (requests/min per IP) ─────────────────────────
LINGUA_THROTTLE_INPUT=200
LINGUA_THROTTLE_DOM=600
# Hard per-request caps on /lingua/translate-input & /translate-dom: max fields
# and max total bytes per call. Oversized requests are served back unchanged
# (never sent to the LLM/Gateway) — stops one request fanning out into a huge bill.
LINGUA_MAX_FIELDS=200
LINGUA_MAX_BYTES=100000

# ── Cache ─────────────────────────────────────────────────────
# file (default) | redis (recommended for production) | memcached
LINGUA_CACHE_DRIVER=file
# TTL in minutes (default: 60 days)
LINGUA_CACHE_TTL=86400
# Cache-Control header set on every HTML page so browsers always revalidate and
# never show a stale page. Empty string = leave the host's own headers untouched.
LINGUA_BROWSER_CACHE_CONTROL="no-cache, must-revalidate"

# ── Middleware toggles ────────────────────────────────────────
LINGUA_TRANSLATE_RESPONSE=true
LINGUA_TRANSLATE_REQUEST=true

# ── Selector UI ───────────────────────────────────────────────
# Position: top-right | top-left | bottom-right | bottom-left
LINGUA_SELECTOR_POSITION=top-right
# Style: flags | names | both
LINGUA_SELECTOR_STYLE=flags
LINGUA_AUTO_DETECT=true

# ── Async translation (opt-in) ────────────────────────────────
# OFF by default. Pages translate inline (atomic) and are page-cached, so
# repeat visits are instant with NO worker. Turn this on ONLY if you run a
# dedicated worker (php artisan queue:work --queue=lingua) AND your queue
# driver is non-sync (database/redis): the first visit then shows a
# "Translating…" banner while a background job runs. Ignored in gateway mode.
LINGUA_ASYNC=false
# Name of the queue to dispatch background translation jobs to
LINGUA_QUEUE=lingua

# ── Quality scoring (optional) ────────────────────────────────
# Gemini auto-scores translations and invalidates low-quality ones (< 7/10)
LINGUA_AUTO_SCORE=false
# Protect /lingua/quality dashboard — access: /lingua/quality?key=SECRET
LINGUA_QUALITY_SECRET=

# ── Few-shot learning (optional) ──────────────────────────────
# Requires: LINGUA_AUTO_SCORE=true + php artisan migrate
# High-scoring translations (>= 8) are saved and injected into future prompts
LINGUA_FEW_SHOT_ENABLED=false
# Max examples injected per translation batch prompt
LINGUA_FEW_SHOT_MAX_EXAMPLES=5
# Hours to cache the example set per language pair (empty table re-checks every request)
LINGUA_FEW_SHOT_CACHE_HOURS=24

# ── Persistent storage & cleanup ──────────────────────────────
# Persist every translation in your DB (table: lingua_translations) so repeat
# visits cost zero LLM calls even after the cache expires. Run `php artisan migrate`.
# database (recommended) | cache (legacy, no persistence) | hybrid (read both, write DB)
LINGUA_STORAGE=database
# Store the request URL with each translation (powers the dashboard's
# "translations on this page" and tells change-detection where to look).
LINGUA_TRACK_URL=true
# When a new source text appears on a page that already has translations, mark
# the previous one obsolete if similarity (0..1) is >= this value.
LINGUA_CHANGE_THRESHOLD=0.8
# Nightly cleanup job (04:00) that prunes long-obsolete rows.
LINGUA_CLEANUP=true
# Export translations to JSONL before deleting obsolete rows.
LINGUA_ARCHIVE=true
# Mark translations obsolete after N days unseen; delete them M more days later.
LINGUA_OBSOLETE_DAYS=30
LINGUA_DELETE_DAYS=90

# ── Autonomous agent / scheduler (opt-in) ─────────────────────
# OFF by default: the agent pre-warms pages + auto-translates newly-enabled
# languages on a schedule, which spends YOUR LLM budget automatically — so it
# never turns itself on. Enable it, then add ONE line to your crontab:
#   * * * * * cd /path-to-your-project && php artisan schedule:run >> /dev/null 2>&1
LINGUA_AGENT_ENABLED=false
# Worker-less cron warm (set false to disable the every-minute auto-warm):
LINGUA_AGENT_AUTO_WARM_CRON=true
# Seconds budget per warm run (keep < 60 so each run fits one cron tick):
LINGUA_AGENT_WARM_SECONDS=50
# ── Agent tuning (all optional; only apply when the agent is enabled) ──
# After route discovery, enqueue a warm job to pre-translate new pages:
# LINGUA_AGENT_AUTO_WARM=true
# After drift detection, automatically retranslate affected pages:
# LINGUA_AGENT_AUTO_RETRANSLATE=true
# Minimum hours between full route scans / content-drift checks:
# LINGUA_AGENT_DISCOVERY_HOURS=6
# LINGUA_AGENT_CHANGE_HOURS=1
# Nightly quality re-evaluation time (HH:MM) and the score below which a
# translation is invalidated and retranslated:
# LINGUA_AGENT_QUALITY_AT=02:00
# LINGUA_AGENT_QUALITY_THRESHOLD=7
# Safety cap on pages processed per agent run:
# LINGUA_AGENT_MAX_PAGES=50
# Opportunistic worker-less warm "tick" from the middleware, and its minimum
# interval in minutes:
# LINGUA_AGENT_TICK=true
# LINGUA_AGENT_TICK_MINUTES=30
# Routes the agent's warm/discovery must not touch (comma-separated):
# LINGUA_AGENT_EXCLUDED_ROUTES=
# Notification channel (log | webhook | slack | email) and webhook URL:
# LINGUA_AGENT_NOTIFY=log
# LINGUA_AGENT_WEBHOOK_URL=

# ── Gateway mode (managed service — alternative to your own LLM key) ──
# LINGUA_MODE=gateway
# LINGUA_LICENSE_KEY=LL-XXXX-XXXX-XXXX-XXXX
# LINGUA_GATEWAY_URL=https://gateway.viataling.com
# Load lingua.js centrally from the gateway (default true → JS fixes reach you
# automatically). Set false to serve the host's own published asset instead.
# LINGUA_GATEWAY_SERVE_ASSETS=true
# HTTP timeout (seconds) for gateway calls, and SSL verification (keep true):
# LINGUA_GATEWAY_TIMEOUT=30
# LINGUA_GATEWAY_VERIFY_SSL=true
# Hours the cached "license valid" check survives a gateway outage (grace window):
# LINGUA_GRACE_HOURS=72

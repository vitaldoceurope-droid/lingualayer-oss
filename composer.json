{
    "name": "lingualayer/lingualayer",
    "description": "Bidirectional AI translation middleware for Laravel — translate any app without touching existing code.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "translation",
        "i18n",
        "internationalization",
        "localization",
        "multilingual",
        "gemini",
        "openai",
        "ai",
        "middleware"
    ],
    "homepage": "https://viataling.com",
    "support": {
        "issues": "https://github.com/vitaldoceurope-droid/lingualayer-oss/issues",
        "source": "https://github.com/vitaldoceurope-droid/lingualayer-oss"
    },
    "authors": [
        {
            "name": "Mohamed Hounaini",
            "email": "contact@viataling.com",
            "homepage": "https://viataling.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/bus": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "LinguaLayer\\": "src/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "autoload-dev": {
        "psr-4": {
            "LinguaLayer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LinguaLayer\\LinguaLayerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

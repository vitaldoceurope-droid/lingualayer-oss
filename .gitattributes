# Normalize line endings to LF everywhere — this package deploys to Linux and
# the toolchain (Pint) enforces LF. Keeps the working copy consistent on Windows.
* text=auto eol=lf

# Shell scripts must keep LF (shebang safety on Linux).
*.sh text eol=lf

# ─────────────────────────────────────────────────────────────────────────────
# Distribution hygiene — keep internal / dev / marketing / sensitive artifacts
# OUT of the Composer dist archive (what `composer require` actually downloads).
# Only the runtime package ships: src, config, database, resources, routes,
# README, LICENSE, CHANGELOG, composer.json, .env.example.
# ─────────────────────────────────────────────────────────────────────────────
/.github                export-ignore
/.claude                export-ignore
/dist                   export-ignore
/site                   export-ignore
/tests                  export-ignore
/bin                    export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.editorconfig          export-ignore
/CLAUDE.md              export-ignore
/phpstan.neon           export-ignore
/phpstan-baseline.neon  export-ignore
/pint.json              export-ignore
/phpunit.xml            export-ignore
/composer.lock          export-ignore
*.pdf                   export-ignore

